<view class="mine-page">
  <view class="profile card fade-up">
    <view class="avatar">🌈</view>
    <view class="profile-copy">
      <view class="profile-name">{{settings.nickname}}</view>
      <view class="profile-sub">已经记录 {{stats.total}} 件小事</view>
    </view>
    <view class="profile-badge">{{stats.streak}} 天</view>
  </view>

  <view class="panel card fade-up">
    <view class="row">
      <view class="row-label">昵称</view>
      <input class="row-input"
             value="{{settings.nickname}}"
             maxlength="12"
             bindinput="onNicknameInput"
             bindblur="onNicknameBlur" />
    </view>
    <view class="row">
      <view class="row-label">每日目标</view>
      <view class="stepper">
        <view class="step-btn {{settings.dailyGoal <= 1 ? 'step-disabled' : ''}}" data-delta="-1" bindtap="onGoalStep">−</view>
        <view class="step-value">{{settings.dailyGoal}}</view>
        <view class="step-btn {{settings.dailyGoal >= 10 ? 'step-disabled' : ''}}" data-delta="1" bindtap="onGoalStep">＋</view>
      </view>
    </view>
    <view class="row row-last">
      <view class="row-label">完成时震动反馈</view>
      <switch checked="{{settings.celebrate}}" color="#9775fa" bindchange="onCelebrateChange" />
    </view>
  </view>

  <view class="panel card fade-up">
    <view class="action-row" bindtap="onClearCompleted">
      <view class="action-icon" style="background: #eef7ff;">🧹</view>
      <view class="action-copy">
        <view class="action-title">清理已完成</view>
        <view class="action-sub">已完成 {{stats.done}} 件</view>
      </view>
      <view class="action-arrow">›</view>
    </view>
    <view class="action-row" bindtap="onExport">
      <view class="action-icon" style="background: #f3efff;">📦</view>
      <view class="action-copy">
        <view class="action-title">导出数据</view>
        <view class="action-sub">复制 JSON 到剪贴板</view>
      </view>
      <view class="action-arrow">›</view>
    </view>
    <view class="action-row action-last" bindtap="onReset">
      <view class="action-icon" style="background: #ffeef0;">🗑</view>
      <view class="action-copy">
        <view class="action-title">清空所有数据</view>
        <view class="action-sub">待办与设置一并重置</view>
      </view>
      <view class="action-arrow">›</view>
    </view>
  </view>

  <view class="about" bindtap="onAbout">彩虹待办 v1.0.0 · 用心记录每一件小事</view>
  <view class="bottom-pad"></view>
</view>
